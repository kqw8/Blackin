<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference template. At runtime, `dusk install` generates an equivalent file at
  ~/Library/LaunchAgents/ pointing at the real binary path, so you normally don't need this file
  by hand. The executable path and the /tmp log paths below are placeholders: the installed agent
  actually logs to ~/Library/Logs/dusk.out.log and dusk.err.log.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kqw8.dusk</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/dusk</string>
        <string>--daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/tmp/dusk.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dusk.err.log</string>
</dict>
</plist>
